{
  "name": "ticket-system",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "bash scripts/setup-git-hooks.sh || true",
    "dev": "npm run dev:server & npm run dev:client",
    "dev:client": "npx vite --host 0.0.0.0 --port 5000",
    "dev:server": "npx tsx watch server/index.ts",
    "build": "npx vite build",
    "start": "NODE_ENV=production PORT=5000 npx tsx server/index.ts",
    "db:push": "npx drizzle-kit push",
    "sync:github": "bash scripts/github-sync.sh",
    "sync:status": "bash scripts/sync-status.sh",
    "hooks:setup": "bash scripts/setup-git-hooks.sh",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.8.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.11",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.30.6",
    "jest": "^30.4.2",
    "postcss": "^8.5.15",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "vite": "^5.4.21"
  }
}
